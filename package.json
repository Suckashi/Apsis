{
  "name": "apsis",
  "version": "0.2.0",
  "private": true,
  "description": "A local Bot workspace powered by Deep Agents.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run check && node scripts/dev.ts",
    "start": "npm run build && node --env-file-if-exists=.env server/index.ts",
    "test": "node --test test/*.test.ts",
    "test:bots:browser": "npm run build && node scripts/verify-bots.ts",
    "test:settings:browser": "npm run build && node scripts/verify-settings.ts",
    "test:bots:ollama": "node scripts/test-bot-delegation.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run check && node scripts/build.ts",
    "dev:share": "npm run check && node --env-file-if-exists=.env scripts/share.ts",
    "test:context:browser": "npm run build && node scripts/verify-context.ts",
    "test:context:model": "node scripts/test-context-model.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.11",
    "@langchain/core": "1.2.12",
    "@langchain/openai": "1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "croner": "^10.0.1",
    "deepagents": "1.14.0",
    "diff": "8.0.4",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "langchain": "1.5.12",
    "mammoth": "^1.12.3",
    "markdown-it": "15.0.2",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "1.3.27",
    "zod": "4.6.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
