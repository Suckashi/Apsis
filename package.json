{
  "name": "talaria",
  "version": "0.1.0",
  "private": true,
  "description": "A Node.js agent workspace weaving Pi execution with Hermes skills and memory.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run check && node scripts/dev.ts",
    "start": "npm run build && node --env-file-if-exists=.env server/index.ts",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run check && node scripts/build.ts",
    "test:ollama": "node scripts/test-ollama.ts",
    "dev:share": "npm run check && node --env-file-if-exists=.env scripts/share.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "markdown-it": "15.0.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
