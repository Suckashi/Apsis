{
  "name": "apsis",
  "version": "0.2.0-alpha.2",
  "private": true,
  "description": "A local Bot workspace powered by Deep Agents.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run check && node scripts/dev.ts",
    "start": "npm run build && node --env-file-if-exists=.env server/index.ts",
    "test": "node --test test/*.test.ts",
    "test:bots:browser": "npm run build && node scripts/verify-bots.ts",
    "test:avatars:browser": "npm run build && node scripts/verify-avatar-picker.ts",
    "test:settings:browser": "npm run build && node scripts/verify-settings.ts",
    "test:settings-reading:browser": "npm run build && node scripts/verify-settings-reading.ts",
    "test:bots:ollama": "node scripts/test-bot-delegation.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run check && node scripts/build.ts",
    "dev:share": "npm run check && node --env-file-if-exists=.env scripts/share.ts",
    "test:context:browser": "npm run build && node scripts/verify-context.ts",
    "test:search:browser": "npm run build && node scripts/verify-roster-search.ts",
    "test:context:model": "node --env-file-if-exists=.env scripts/test-context-model.ts",
    "test:files:browser": "npm run build && node scripts/verify-work-files.ts",
    "test:chat:browser": "npm run build && node scripts/verify-chat.ts",
    "test:entry:browser": "npm run build && node scripts/verify-conversation-entry.ts",
    "test:reading:browser": "npm run build && node scripts/verify-markdown-reading.ts",
    "test:reading-position:browser": "npm run build && node scripts/verify-reading-position.ts",
    "test:requests:browser": "npm run build && node scripts/verify-user-message.ts",
    "test:chat:edge": "npm run build && node scripts/verify-chat.ts --browser=msedge",
    "test:requests:edge": "npm run build && node scripts/verify-user-message.ts --browser=msedge",
    "test:templates:browser": "npm run build && node scripts/verify-template-reading.ts",
    "test:providers:browser": "npm run build && node scripts/verify-provider-reading.ts",
    "test:preview-reading:browser": "npm run build && node scripts/verify-preview-reading.ts",
    "test:composer:browser": "npm run build && node scripts/verify-mobile-composer.ts",
    "test:workspace:browser": "npm run build && node scripts/verify-workspace-ux.ts",
    "test:performance:browser": "npm run build && node scripts/verify-conversation-performance.ts",
    "test:accessibility:browser": "npm run build && node scripts/verify-accessibility.ts",
    "test:artifacts:browser": "npm run build && node scripts/verify-artifact-preview.ts",
    "test:bundles:browser": "npm run build && node scripts/verify-published-bundle.ts",
    "test:documents:browser": "npm run build && node scripts/verify-document-export.ts",
    "test:document-reading:browser": "npm run build && node scripts/verify-document-reading.ts",
    "test:network:browser": "npm run build && node scripts/verify-network-resilience.ts",
    "test:removal:browser": "npm run build && node scripts/verify-bot-removal-sync.ts",
    "test:startup:browser": "npm run build && node scripts/verify-startup-performance.ts --isolated --repeat --verify",
    "check:docs": "node scripts/check-docs.ts",
    "test:release": "node scripts/verify-release-source.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@langchain/anthropic": "1.5.11",
    "@langchain/core": "1.2.12",
    "@langchain/openai": "1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rainbowatcher/toml-edit-js": "0.6.5",
    "@xmldom/xmldom": "^0.8.15",
    "croner": "^10.0.1",
    "deepagents": "1.14.0",
    "diff": "8.0.4",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "langchain": "1.5.12",
    "mammoth": "^1.12.3",
    "markdown-it": "15.0.2",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "1.3.27",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "jszip": "3.10.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
