# Prefer the Connection Settings UI; environment variables remain an optional fallback.
# Node.js 22.19+; no key needed for the clearly labelled demo mode.
PORT=3100
PI_PROVIDER=openai
PI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Alternatively: PI_PROVIDER=anthropic, PI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# Local alternative: PI_PROVIDER=ollama, PI_MODEL=qwen3.5:9b (no key)
OLLAMA_URL=http://127.0.0.1:11434
# Custom Chat Completions endpoint: PI_PROVIDER=openai-compatible, PI_MODEL=your-model-id
# Include the service's complete API base path (e.g. /v1 or /api/v1).
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
# Optional password-protected sharing; npm run dev does not start a tunnel.
SHARE_PORT=3102
